# PortfolioIQ Environment Configuration
DJANGO_ENV=development
SECRET_KEY=insecure-dev-secret-key-change-in-production-portfolioiq-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in Docker / SQLite fallback for lightweight test)
DATABASE_URL=postgres://portfolioiq:portfolioiq_secret@localhost:5432/portfolioiq_db
USE_SQLITE=False

# Redis Configuration (Cache, Celery Broker, Channel Layer)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Market Data Settings
MARKET_DATA_PROVIDER=mock
MARKET_DATA_API_KEY=

# Security & Tokens
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7
